# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
VITE_SUPABASE_URL=
# Used by client.ts + products.functions.ts (Lovable's generated name)
SUPABASE_PUBLISHABLE_KEY=

# Used by server functions (payments, paypal, products admin)
# GET FROM: supabase.com → project bhouuzbzoxupejlsymrh → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Vite client-side (must use VITE_ prefix)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── PayPal ────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=

# ── App URL ───────────────────────────────────────────────────────────────────
# IMPORTANT: change this to your real deployed domain before going live
# e.g. https://rewindd.co.uk — Stripe + PayPal use this for redirect URLs
PUBLIC_URL=